{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portus-qc.dev/schemas/app-inspection.schema.json",
  "title": "Portus QC local application inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "prompt", "enabled", "capability"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "enabled": { "type": "boolean" },
    "capability": { "enum": ["query", "detect", "segment", "point", "caption"] }
  }
}
