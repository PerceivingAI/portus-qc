{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portus-qc.dev/schemas/app-camera.schema.json",
  "title": "Portus QC saved camera",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slot", "host", "protocol", "stream", "transport", "rtspClient", "rtspAuth"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "slot": { "type": "integer", "minimum": 1, "maximum": 4 },
    "alias": { "type": "string", "minLength": 1, "maxLength": 120 },
    "host": { "type": "string", "minLength": 1, "maxLength": 255 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "enum": ["rtsp", "rtsps"] },
    "stream": { "enum": ["stream1", "stream2"] },
    "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "transport": { "enum": ["tcp", "udp"] },
    "rtspClient": { "enum": ["gortsplib", "ffmpeg"] },
    "rtspAuth": { "enum": ["auto", "basic", "digest"] }
  }
}
